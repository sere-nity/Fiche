# Local Postgres:
# DATABASE_URL=postgres://USER@localhost:5432/fiche
# Neon (use the pooled connection string):
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# AI calls (question generator, examiner, grader). Set ONE of these; OpenRouter wins if both are set.
# Capture (reading, saving cards) needs neither.
XAI_API_KEY=
OPENROUTER_API_KEY=
